# Kopiér denne fil til .env.local og udfyld med dine egne værdier.
# Hentes i Supabase: Project Settings -> API.
# VIGTIGT: brug KUN den offentlige "anon / public" nøgle her — ALDRIG
# service_role-nøglen og ALDRIG database-adgangskoden fra R-loaderen.
# .env.local er git-ignoreret og må aldrig committes.

VITE_SUPABASE_URL=https://<dit-projekt-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<din-anon-public-key>
