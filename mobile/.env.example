# Supabase — anon/publishable nøgle (offentlig by design; RLS gater læseadgang).
# Kopiér til mobile/.env (gitignored) og indsæt projektets værdier. Anon/publishable-nøglen
# kan findes i Supabase-dashboardet (Project Settings → API) eller design/data/supabase-kobling.md.
EXPO_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<din-publishable-noegle>
