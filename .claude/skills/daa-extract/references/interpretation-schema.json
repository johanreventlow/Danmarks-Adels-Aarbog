{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danmarksadelsaarbog.dk/schema/evidence-interpretation-1.0.json",
  "type": "object",
  "required": ["interpretation_id", "observation_ids", "predicate", "value", "status", "method", "created_at"],
  "additionalProperties": false,
  "properties": {
    "interpretation_id": {"type": "string", "minLength": 1},
    "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "status": {"enum": ["proposed", "accepted", "rejected"]},
    "method": {"enum": ["explicit_source", "deterministic", "model", "human"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
