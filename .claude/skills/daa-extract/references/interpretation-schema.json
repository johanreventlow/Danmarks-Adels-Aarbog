{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://danmarksadelsaarbog.dk/schema/evidence-interpretation-1.1.json",
  "type": "object",
  "required": [
    "interpretation_id",
    "observation_ids",
    "predicate",
    "value",
    "status",
    "method",
    "created_at"
  ],
  "additionalProperties": false,
  "properties": {
    "interpretation_id": {
      "type": "string",
      "minLength": 1
    },
    "observation_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "value": {},
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "unresolved",
        "superseded"
      ]
    },
    "method": {
      "enum": [
        "explicit_source",
        "deterministic",
        "model",
        "human"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "value_kind": {
      "type": "string",
      "enum": [
        "text",
        "date_raw",
        "name",
        "event",
        "relation",
        "mention"
      ],
      "description": "Værdiform; ejes af private.interpretation_predicate (#147 4.2)."
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "date_raw": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Værdiform name: ordret raw plus valgfri normalisering."
    },
    "event": {
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Værdiform event: ordret raw plus valgfri normalisering."
    },
    "relation": {
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Værdiform relation: ordret raw plus valgfri normalisering."
    },
    "mention": {
      "type": "object",
      "required": [
        "raw"
      ],
      "properties": {
        "raw": {
          "type": "string",
          "minLength": 1
        },
        "normalized": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true,
      "description": "Værdiform mention: ordret raw plus valgfri normalisering."
    }
  }
}
